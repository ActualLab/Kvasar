<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="$(UseMultitargeting)">net10.0;net9.0</TargetFrameworks>
    <RootNamespace>ActualLab.Kvasar.Tests</RootNamespace>
    <AssemblyName>ActualLab.Kvasar.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ActualLab.Kvasar\ActualLab.Kvasar.csproj" />
    <!-- Build-order only (no assembly reference): guarantees the crash worker exists before the
         process-kill recovery tests go looking for it. -->
    <ProjectReference Include="..\..\tools\ActualLab.Kvasar.CrashWorker\ActualLab.Kvasar.CrashWorker.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
