<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="latest" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(RepoRoot)artifacts\tests</ArtifactsPath>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Suppressed warnings for tests (the repo-wide ones live in the root Directory.Build.props) -->
  <PropertyGroup>
    <!-- CA1032: exception ctor overloads; CA1052: static holder type; CA1303: literal string passed to Console -->
    <!-- CA1305/CA1307/CA1310/CA1862: culture/comparison overloads -->
    <!-- CA1515: types can be internal; CA1721: property confusing given a Get* method -->
    <!-- CA1812: internal class apparently never instantiated; CA1822: member can be static -->
    <!-- CA1852: type can be sealed; CA1861: prefer 'static readonly' over constant array arguments -->
    <NoWarn>$(NoWarn);CA1032;CA1052;CA1303;CA1305;CA1307;CA1310;CA1515;CA1721;CA1812;CA1822;CA1852;CA1861;CA1862</NoWarn>
    <!-- CA2002: lock on weak identity; CA2007: ConfigureAwait; CA2016: forward CancellationToken -->
    <!-- CA2201: reserved exception type; CA2237: [Serializable] -->
    <NoWarn>$(NoWarn);CA2002;CA2007;CA2016;CA2201;CA2237</NoWarn>
    <!-- MA0002/MA0006/MA0011/MA0074: comparer/provider/comparison overloads; MA0004: ConfigureAwait(false) -->
    <NoWarn>$(NoWarn);MA0002;MA0004;MA0006;MA0011;MA0074</NoWarn>
    <!-- IL2060/IL2111: reflection over annotated members (test-only, nothing here is trimmed) -->
    <!-- NU1510: unpruned PackageReference -->
    <!-- RCS1059: lock on private field instead of 'this'; RCS1155: StringComparison when comparing strings -->
    <!-- xUnit1030/xUnit1031: ConfigureAwait / sync-blocking in tests -->
    <NoWarn>$(NoWarn);IL2060;IL2111;NU1510;RCS1059;RCS1155;xUnit1030;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.analyzers" PrivateAssets="all" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
  </ItemGroup>

  <!-- Global usings -->
  <ItemGroup>
    <Using Include="System.Buffers" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="ActualLab.Kvasar" />
    <Using Include="AwesomeAssertions" />
    <Using Include="Xunit" />
    <Using Include="Xunit.Abstractions" />
  </ItemGroup>

</Project>
