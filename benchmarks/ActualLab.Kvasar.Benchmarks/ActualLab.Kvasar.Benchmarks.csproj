<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks Condition="$(UseMultitargeting)">net10.0;net9.0</TargetFrameworks>
    <RootNamespace>ActualLab.Kvasar.Benchmarks</RootNamespace>
    <AssemblyName>ActualLab.Kvasar.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- Benchmark harness: relax analyzers, it isn't shipped -->
    <AnalysisMode>Default</AnalysisMode>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1050;CA1852;CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ActualLab.Kvasar\ActualLab.Kvasar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="sqlite-net-sqlcipher" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
  </ItemGroup>

</Project>
